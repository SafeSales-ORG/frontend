# SafeSale frontend environment variables.
# Copy to `.env` and fill in. Never commit `.env`.

# Demo mode. When "true", the whole app runs on an in-memory mock
# (no backend) and /admin is unlocked. Set to "false" to use the real
# backend at VITE_API_URL.
VITE_DEMO_MODE=true

# Backend API base URL
VITE_API_URL=http://localhost:3000

# Public app URL (used in shared links, OG tags)
VITE_APP_URL=http://localhost:8080

# Google sign-in. Leave VITE_GOOGLE_ENABLED unset/false to hide the button.
# Create a client at https://console.cloud.google.com → APIs & Services →
# Credentials → OAuth 2.0 Client ID → Web application, and add this app's
# origins under "Authorized JavaScript origins".
VITE_GOOGLE_ENABLED=false
VITE_GOOGLE_CLIENT_ID=

# Email of the mediator account — the only account allowed into /admin.
VITE_MEDIATOR_EMAIL=

# Support contacts shown in the Help dialog.
VITE_SUPPORT_EMAIL=
# WhatsApp number, digits only, international format (no +). e.g. 2348012345678
VITE_SUPPORT_WHATSAPP=
